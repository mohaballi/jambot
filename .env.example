# Bot Configuration
BOT_USERNAME=jambot

# Namespace
# Namespace devbox name to connect to.
DEVBOX_NAME=jambox
# Namespace credential. Use your local session token (st_...) or a revokable
# tenant token (nsct_...). Required on serverless hosts, where the SDK cannot
# find a local token file. - secret
NAMESPACE_TOKEN=

# Slack
# Credential modes
# Single workspace bot token
# Slack bot token. - secret
SLACK_BOT_TOKEN=
# Slack signing secret for webhook verification. - secret
SLACK_SIGNING_SECRET=
# Multi-workspace OAuth
# Slack app client ID.
SLACK_CLIENT_ID=
# Slack app client secret. - secret
SLACK_CLIENT_SECRET=
# Slack signing secret for webhook verification. - secret
SLACK_SIGNING_SECRET=
# Optional
# Slack app-level token for Socket Mode. - secret
SLACK_APP_TOKEN=
# AES-256-GCM key for encrypting stored OAuth tokens. - secret
SLACK_ENCRYPTION_KEY=
# Override the Slack API base URL.
SLACK_API_URL=
# Secret used to authenticate forwarded Socket Mode events. - secret
SLACK_SOCKET_FORWARDING_SECRET=

# PostgreSQL
# Constructor config: client, keyPrefix, autoCreateSchema
# Credential modes
# Connection URL
# Postgres connection URL used when a client is not provided. - aliases: DATABASE_URL
POSTGRES_URL=
# Existing client
